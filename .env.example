# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_risk

# JWT signing secret — change this to any long random string
JWT_SECRET=change-me-in-production

# Flask
FLASK_DEBUG=false
PORT=5000

# CORS
ALLOWED_ORIGINS=http://localhost:5000
